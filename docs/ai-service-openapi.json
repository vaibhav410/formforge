    "components":  {
                       "schemas":  {
                                       "AiResult":  {
                                                        "properties":  {
                                                                           "schema":  {
                                                                                          "additionalProperties":  true,
                                                                                          "type":  "object",
                                                                                          "title":  "Schema"
                                                                                      },
                                                                           "model":  {
                                                                                         "type":  "string",
                                                                                         "title":  "Model"
                                                                                     },
                                                                           "total_latency_ms":  {
                                                                                                    "type":  "integer",
                                                                                                    "title":  "Total Latency Ms"
                                                                                                },
                                                                           "prompt_tokens":  {
                                                                                                 "type":  "integer",
                                                                                                 "title":  "Prompt Tokens"
                                                                                             },
                                                                           "completion_tokens":  {
                                                                                                     "type":  "integer",
                                                                                                     "title":  "Completion Tokens"
                                                                                                 },
                                                                           "attempts":  {
                                                                                            "items":  {
                                                                                                          "$ref":  "#/components/schemas/AttemptLog"
                                                                                                      },
                                                                                            "type":  "array",
                                                                                            "title":  "Attempts"
                                                                                        }
                                                                       },
                                                        "type":  "object",
                                                        "required":  [
                                                                         "schema",
                                                                         "model",
                                                                         "total_latency_ms",
                                                                         "prompt_tokens",
                                                                         "completion_tokens",
                                                                         "attempts"
                                                                     ],
                                                        "title":  "AiResult"
                                                    },
                                       "AttemptLog":  {
                                                          "properties":  {
                                                                             "attempt":  {
                                                                                             "type":  "integer",
                                                                                             "title":  "Attempt"
                                                                                         },
                                                                             "model":  {
                                                                                           "type":  "string",
                                                                                           "title":  "Model"
                                                                                       },
                                                                             "outcome":  {
                                                                                             "type":  "string",
                                                                                             "enum":  [
                                                                                                          "success",
                                                                                                          "invalid_json",
                                                                                                          "schema_invalid",
                                                                                                          "provider_error"
                                                                                                      ],
                                                                                             "title":  "Outcome"
                                                                                         },
                                                                             "latency_ms":  {
                                                                                                "type":  "integer",
                                                                                                "title":  "Latency Ms"
                                                                                            },
                                                                             "prompt_tokens":  {
                                                                                                   "anyOf":  [
                                                                                                                 {
                                                                                                                     "type":  "integer"
                                                                                                                 },
                                                                                                                 {
                                                                                                                     "type":  "null"
                                                                                                                 }
                                                                                                             ],
                                                                                                   "title":  "Prompt Tokens"
                                                                                               },
                                                                             "completion_tokens":  {
                                                                                                       "anyOf":  [
                                                                                                                     {
                                                                                                                         "type":  "integer"
                                                                                                                     },
                                                                                                                     {
                                                                                                                         "type":  "null"
                                                                                                                     }
                                                                                                                 ],
                                                                                                       "title":  "Completion Tokens"
                                                                                                   },
                                                                             "response_excerpt":  {
                                                                                                      "anyOf":  [
                                                                                                                    {
                                                                                                                        "type":  "string"
                                                                                                                    },
                                                                                                                    {
                                                                                                                        "type":  "null"
                                                                                                                    }
                                                                                                                ],
                                                                                                      "title":  "Response Excerpt"
                                                                                                  }
                                                                         },
                                                          "type":  "object",
                                                          "required":  [
                                                                           "attempt",
                                                                           "model",
                                                                           "outcome",
                                                                           "latency_ms"
                                                                       ],
                                                          "title":  "AttemptLog",
                                                          "description":  "One LLM round-trip; Laravel persists these as prompt_logs rows."
                                                      },
                                       "EditRequest":  {
                                                           "properties":  {
                                                                              "prompt":  {
                                                                                             "type":  "string",
                                                                                             "maxLength":  4000,
                                                                                             "minLength":  3,
                                                                                             "title":  "Prompt"
                                                                                         },
                                                                              "schema":  {
                                                                                             "additionalProperties":  true,
                                                                                             "type":  "object",
                                                                                             "title":  "Schema"
                                                                                         }
                                                                          },
                                                           "type":  "object",
                                                           "required":  [
                                                                            "prompt",
                                                                            "schema"
                                                                        ],
                                                           "title":  "EditRequest"
                                                       },
                                       "ErrorResponse":  {
                                                             "properties":  {
                                                                                "detail":  {
                                                                                               "type":  "string",
                                                                                               "title":  "Detail"
                                                                                           },
                                                                                "attempts":  {
                                                                                                 "items":  {
                                                                                                               "$ref":  "#/components/schemas/AttemptLog"
                                                                                                           },
                                                                                                 "type":  "array",
                                                                                                 "title":  "Attempts",
                                                                                                 "default":  [

                                                                                                             ]
                                                                                             }
                                                                            },
                                                             "type":  "object",
                                                             "required":  [
                                                                              "detail"
                                                                          ],
                                                             "title":  "ErrorResponse"
                                                         },
                                       "GenerateRequest":  {
                                                               "properties":  {
                                                                                  "prompt":  {
                                                                                                 "type":  "string",
                                                                                                 "maxLength":  4000,
                                                                                                 "minLength":  3,
                                                                                                 "title":  "Prompt"
                                                                                             },
                                                                                  "locale":  {
                                                                                                 "anyOf":  [
                                                                                                               {
                                                                                                                   "type":  "string",
                                                                                                                   "maxLength":  10
                                                                                                               },
                                                                                                               {
                                                                                                                   "type":  "null"
                                                                                                               }
                                                                                                           ],
                                                                                                 "title":  "Locale"
                                                                                             }
                                                                              },
                                                               "type":  "object",
                                                               "required":  [
                                                                                "prompt"
                                                                            ],
                                                               "title":  "GenerateRequest"
                                                           },
                                       "TranslateRequest":  {
                                                                "properties":  {
                                                                                   "target_language":  {
                                                                                                           "type":  "string",
                                                                                                           "maxLength":  50,
                                                                                                           "minLength":  2,
                                                                                                           "title":  "Target Language"
                                                                                                       },
                                                                                   "schema":  {
                                                                                                  "additionalProperties":  true,
                                                                                                  "type":  "object",
                                                                                                  "title":  "Schema"
                                                                                              }
                                                                               },
                                                                "type":  "object",
                                                                "required":  [
                                                                                 "target_language",
                                                                                 "schema"
                                                                             ],
                                                                "title":  "TranslateRequest"
                                                            }
                                   },
                       "securitySchemes":  {
                                               "HTTPBearer":  {
                                                                  "type":  "http",
                                                                  "scheme":  "bearer"
                                                              }
                                           }
                   }
}
